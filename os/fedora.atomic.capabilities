# os/fedora.atomic.capabilities — the ATOMIC edition's declaration (Silverblue, Kinoite,
# any bootc host). Selected by bootstrap.sh's bootstrap_wire_pre_loader when
# /run/ostree-booted exists; os/fedora.capabilities stays the dnf one. Read by Core's
# 02-capabilities.zsh; validated by core/scripts/check-capabilities.sh.
#
# THE SOURCE of the atomic column of the "Package-manager commands" table in
# dotfiles-core's PORTING-MATRIX.md once gen-porting-matrix.sh's registry carries it
# (`Atomic=os/fedora.atomic.capabilities`, the Leap idiom) — edit here, then run
# `make gen-porting-matrix` in dotfiles-core.
# Validate with:  core/scripts/check-capabilities.sh os/fedora.atomic.capabilities
# The DELTA against os/fedora.capabilities is a contract of its own, gated by
# test/check-flavors.sh (`make suite`): the keys that may differ, and the ones that must not.
#
# A `#` INSIDE A VALUE IS NOT A COMMENT — the reader keeps it. Notes go above.
#
# What differs from the dnf declaration, and why (measured on fedora-bootc:42):
#   · install and upgrade STAGE a new deployment; nothing is live until PKG_APPLY.
#     `dnf install` resolves and then refuses ("configured to be read-only").
#   · "is a change staged?" is answered by an exit status (77) — PKG_APPLY_PENDING (R5);
#     "is there something newer?" has no unprivileged verb, so no PKG_COUNT_PENDING.
#   · no PKG_ASSUME_YES (nothing prompts), no PKG_UPGRADE_PARTIAL (the image updates as
#     a whole). MAINT_UNATTENDED_UPGRADE stays: a staged upgrade is inert until the
#     operator reboots, so unattended staging is SAFER than a mutable upgrade.

PROVISIONER=atomic

# ── package-manager verbs (required) ──────────────────────────────────────────
PKG_REFRESH=sudo rpm-ostree refresh-md
PKG_UPGRADE=sudo rpm-ostree upgrade
PKG_INSTALL=sudo rpm-ostree install --idempotent
PKG_REMOVE=sudo rpm-ostree uninstall
PKG_SEARCH=dnf search
PKG_OWNS=rpm -qf
# R5: no count verb — the AVAILABLE question is root-only here (measured); the maint
# runner's unattended `rpm-ostree upgrade` asks it, the nudge reports the STAGED state.
PKG_APPLY_PENDING=rpm-ostree status --pending-exit-77
PKG_APPLY_PENDING_EXIT=77

# ── the staged change becomes live ────────────────────────────────────────────
PKG_APPLY=sudo systemctl reboot

# ── what --packages must not nag about (#1087) ────────────────────────────────
# Four base-system binaries across this edition's verbs, none of them in packages.txt:
# `rpm-ostree` stages, `dnf` and `rpm` query, and `systemctl` is what the staged change
# becomes live through.
PKG_UNLISTED_TOOLS=rpm-ostree dnf rpm systemctl

# ── scheduler (required) ──────────────────────────────────────────────────────
SCHEDULER=systemd
SCHEDULER_UNIT_DIR=~/.config/systemd/user

# ── how `up` applies (optional) ───────────────────────────────────────────────
MAINT_UNATTENDED_UPGRADE=1
